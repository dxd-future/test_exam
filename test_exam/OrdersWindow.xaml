<Window x:Class="test_exam.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DgOrders" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding article}"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding date_order}"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding surename}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding adress}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnAddOrder" Content="Добавить заказ" Click="BtnAddOrder_Click"/>
            <Button Content="Закрыть" Click="BtnClose_Click" Background="#FFD3D3D3"/>
        </StackPanel>
    </Grid>
</Window>