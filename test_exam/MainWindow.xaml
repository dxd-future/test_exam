<Window x:Class="test_exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары - ООО Обувь" Height="700" Width="1100" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Image Source="Images/picture.png" Width="50" Height="50" Margin="0,0,10,0"/>
            <TextBlock x:Name="TbUserInfo" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel x:Name="PanelFilters" Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,10" Visibility="Collapsed">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="TbSearch" Width="150" TextChanged="TbSearch_TextChanged" Margin="0,0,15,0"/>

            <TextBlock Text="Фильтр (Поставщик):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CbFilter" Width="150" SelectionChanged="CbFilter_SelectionChanged" Margin="0,0,15,0"/>

            <TextBlock Text="Сортировка (Кол-во):" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CbSort" Width="150" SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="DgProducts" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Фото" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="50" Height="50" Stretch="Uniform" Margin="5">
                                <Image.Source>
                                    <Binding Path="photo" StringFormat="pack://application:,,,/Images/{0}" TargetNullValue="{x:Null}"/>
                                </Image.Source>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Артикул" Binding="{Binding article}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price}" Width="80"/>
                <DataGridTextColumn Header="Скидка %" Binding="{Binding sale}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding count}" Width="80"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding info}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnAdd" Content="Добавить товар" Click="BtnAdd_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnEdit" Content="Редактировать" Click="BtnEdit_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnDelete" Content="Удалить" Click="BtnDelete_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnOrders" Content="Заказы" Click="BtnOrders_Click" Visibility="Collapsed"/>
            <Button Content="Выход" Click="BtnExit_Click" Background="#FFA0A0"/>
        </StackPanel>
    </Grid>
</Window>