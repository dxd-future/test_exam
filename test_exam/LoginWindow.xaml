<Window x:Class="test_exam.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - ООО Обувь" Height="400" Width="600" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип -->
        <Image Source="Images/picture.png" Grid.Column="0" Margin="20" Stretch="Uniform"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="TbLogin" Margin="0,5,0,15" Height="25"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PbPassword" Margin="0,5,0,15" Height="25"/>

            <Button Content="Войти" Click="BtnLogin_Click"/>
            <Button Content="Войти как гость" Click="BtnGuest_Click" Background="{StaticResource SecondaryBackground}"/>
        </StackPanel>
    </Grid>
</Window>